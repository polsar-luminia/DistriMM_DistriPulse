# --- distrimm-sms: variables de entorno (copiar a .env en el VPS y completar) ---

# Supabase (mismo proyecto DistriMM)
SUPABASE_URL=https://xzhqhmjfhnvqxndxayxs.supabase.co
# Service role key (Dashboard -> Project Settings -> API -> service_role). NUNCA exponer en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# LabsMobile (Panel -> API Settings). Basic Auth = usuario(email):tokenapi
LABSMOBILE_USERNAME=
LABSMOBILE_TOKEN=
# Remitente opcional (tpoa). En Colombia LabsMobile entrega por shortcode compartido; este campo puede ignorarse.
LABSMOBILE_TPOA=

# Puerto local (nginx ya proxya /api/ -> localhost:3103)
PORT=3103

# Origenes permitidos para CORS (separados por coma)
ALLOWED_ORIGIN=https://distrimm.luminiatech.digital,http://localhost:5173

# (Fase 2, opcional) URL publica del webhook de estados de entrega para el ackurl de LabsMobile
# SMS_ACK_URL=https://distrimm.luminiatech.digital/api/sms/webhook
