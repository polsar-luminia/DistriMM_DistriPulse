# DistriMM MCP Server — variables de entorno
# El .env real vive SOLO en el VPS (/var/www/distrimm-agro/mcp-server/.env)

# Proyecto Supabase (mismo del frontend)
SUPABASE_URL=https://xzhqhmjfhnvqxndxayxs.supabase.co

# Service role key (Dashboard Supabase → Settings → API → service_role).
# NUNCA en el frontend ni en git. Solo el MCP la usa para llamar las fn_mcp_*.
SUPABASE_SERVICE_ROLE_KEY=

# Token de acceso del conector (la "llave" que va en la URL del conector).
# Generar con: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# Puerto local (nginx hace proxy de /mcp hacia aquí)
PORT=3102
